<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_BPMN02B" targetNamespace="http://ehealth-ea/bpmn" exporter="tv1-gen" exporterVersion="1">
  <bpmn:collaboration id="Collab_BPMN02B">
    <bpmn:participant id="P_Pharm" name="Nhà thuốc đối tác" processRef="Proc_P_Pharm"/>
    <bpmn:participant id="P_Clinic" name="Phòng khám ĐK An Tâm" processRef="Proc_P_Clinic"/>
    <bpmn:messageFlow id="Msg_1" name="Bản ghi cấp + dispenseId" sourceRef="b5" targetRef="cs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Pharm" name="Nhà thuốc đối tác" isExecutable="false">
    <bpmn:laneSet id="LS_P_Pharm">
      <bpmn:lane id="L_DS" name="Dược sĩ (BR-DuocSi)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>en</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AG" name="Tác tử nhà thuốc (offline-first)">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="BN xuất trình mã đơn"><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s"/></bpmn:startEvent>
    <bpmn:userTask id="t1" name="BP-05.1 Tiếp nhận &amp; tra cứu đơn"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Kết nối hệ thống được?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="tn" name="Cấp theo luồng chính (BP-05.2 → BP-05.3)"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="en" name="Hoàn tất"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="b1" name="BP-06B.1 Tra đơn trong bộ nhớ đệm"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Đơn có trong cache, còn hạn, không phải thuốc kiểm soát?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="b2" name="BP-06B.2 Từ chối cấp, hướng dẫn BN"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e2" name="Không cấp"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="b3" name="BP-06B.3 Cấp có giới hạn, ghi phiếu cấp offline (dispenseId)"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="b4" name="BP-06B.4 Ghi hàng đợi đồng bộ cục bộ"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="c1" name="Kết nối khôi phục"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:conditionalEventDefinition id="CED_c1"><bpmn:condition xsi:type="bpmn:tFormalExpression">online</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="b5" name="BP-06B.5 Đồng bộ bản ghi cấp (idempotent)"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e5" name="Đã gửi đồng bộ"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="tn" targetRef="en"/>
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="b1" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="b2" targetRef="e2"/>
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="b3" targetRef="b4"/>
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="b4" targetRef="c1"/>
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="c1" targetRef="b5"/>
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="b5" targetRef="e5"/>
    <bpmn:sequenceFlow id="Flow_15" name="Có" sourceRef="g1" targetRef="tn"/>
    <bpmn:sequenceFlow id="Flow_16" name="Không" sourceRef="g1" targetRef="b1"/>
    <bpmn:sequenceFlow id="Flow_17" name="Có" sourceRef="g2" targetRef="b3"/>
    <bpmn:sequenceFlow id="Flow_18" name="Không" sourceRef="g2" targetRef="b2"/>
  </bpmn:process>
  <bpmn:process id="Proc_P_Clinic" name="Phòng khám ĐK An Tâm" isExecutable="false">
    <bpmn:laneSet id="LS_P_Clinic">
      <bpmn:lane id="L_SYS" name="Hệ thống E-Health">
        <bpmn:flowNodeRef>cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_QL" name="Quản lý vận hành (BR-QuanLy)">
        <bpmn:flowNodeRef>b8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="cs" name="Nhận lô đồng bộ"><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:messageEventDefinition id="MED_cs"/></bpmn:startEvent>
    <bpmn:serviceTask id="b6" name="BP-06B.6 Đối chiếu với trạng thái đơn"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Cấp trùng / vượt số lượng?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="b7" name="BP-06B.7 Cập nhật trạng thái đơn &amp; ghi audit"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e7" name="Đơn nhất quán"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="b8" name="BP-06B.8 Đối soát thủ công, liên hệ BN &amp; nhà thuốc"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="b9" name="BP-06B.9 Ghi kết quả đối soát (audit)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e9" name="Xung đột đã xử lý"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="cs" targetRef="b6"/>
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="b6" targetRef="g3"/>
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="b7" targetRef="e7"/>
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="b8" targetRef="b9"/>
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="b9" targetRef="e9"/>
    <bpmn:sequenceFlow id="Flow_19" name="Không" sourceRef="g3" targetRef="b7"/>
    <bpmn:sequenceFlow id="Flow_20" name="Có" sourceRef="g3" targetRef="b8"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_BPMN02B" name="BPMN-02B Nhà thuốc mất kết nối – cấp có giới hạn &amp; đối soát (BP-06B)"><bpmndi:BPMNPlane id="Plane_BPMN02B" bpmnElement="Collab_BPMN02B">
