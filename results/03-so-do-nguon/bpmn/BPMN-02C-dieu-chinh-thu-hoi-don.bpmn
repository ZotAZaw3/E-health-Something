    <bpmndi:BPMNEdge id="Msg_3_di" bpmnElement="Msg_3"><di:waypoint x="1280" y="712"/><di:waypoint x="1280" y="373"/><bpmndi:BPMNLabel><dc:Bounds x="1286" y="359" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>