    <bpmndi:BPMNShape id="gm_di" bpmnElement="gm" isMarkerVisible="true"><dc:Bounds x="835" y="330" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="810.0" y="384.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c6_di" bpmnElement="c6"><dc:Bounds x="944" y="322" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="eg_di" bpmnElement="eg"><dc:Bounds x="1115" y="330" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1090.0" y="384.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ok_di" bpmnElement="ok"><dc:Bounds x="1262" y="337" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1230.0" y="377.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="eok_di" bpmnElement="eok"><dc:Bounds x="1402" y="337" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1370.0" y="377.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="to_di" bpmnElement="to"><dc:Bounds x="1402" y="419" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1370.0" y="459.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c8_di" bpmnElement="c8"><dc:Bounds x="1504" y="497" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e8_di" bpmnElement="e8"><dc:Bounds x="1682" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1650.0" y="552.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ps_di" bpmnElement="ps"><dc:Bounds x="982" y="727" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="950.0" y="767.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c7_di" bpmnElement="c7"><dc:Bounds x="1084" y="712" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="pc_di" bpmnElement="pc"><dc:Bounds x="1224" y="712" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="pe_di" bpmnElement="pe"><dc:Bounds x="1402" y="727" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1370.0" y="767.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="178" y="180"/><di:waypoint x="244" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="356" y="180"/><di:waypoint x="362" y="180"/><di:waypoint x="362" y="355"/><di:waypoint x="384" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="496" y="355"/><di:waypoint x="555" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="776" y="437"/><di:waypoint x="813" y="437"/><di:waypoint x="813" y="355"/><di:waypoint x="835" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="776" y="180"/><di:waypoint x="813" y="180"/><di:waypoint x="813" y="355"/><di:waypoint x="835" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="776" y="262"/><di:waypoint x="813" y="262"/><di:waypoint x="813" y="355"/><di:waypoint x="835" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="885" y="355"/><di:waypoint x="944" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1056" y="355"/><di:waypoint x="1115" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1165" y="355"/><di:waypoint x="1262" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1140" y="380"/><di:waypoint x="1140" y="437"/><di:waypoint x="1402" y="437"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1298" y="355"/><di:waypoint x="1402" y="355"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1438" y="437"/><di:waypoint x="1482" y="437"/><di:waypoint x="1482" y="530"/><di:waypoint x="1504" y="530"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1616" y="530"/><di:waypoint x="1682" y="530"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1018" y="745"/><di:waypoint x="1084" y="745"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1196" y="745"/><di:waypoint x="1224" y="745"/></bpmndi:BPMNEdge>
