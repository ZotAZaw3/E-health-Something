    <bpmndi:BPMNShape id="L_DS_di" bpmnElement="L_DS" isHorizontal="true"><dc:Bounds x="50" y="695" width="1750" height="175"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="142" y="162" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="110.0" y="202.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c1_di" bpmnElement="c1"><dc:Bounds x="244" y="147" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c2_di" bpmnElement="c2"><dc:Bounds x="384" y="322" width="112" height="66"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="555" y="330" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="530.0" y="384.0" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="c3_di" bpmnElement="c3"><dc:Bounds x="664" y="404" width="112" height="66"/></bpmndi:BPMNShape>
