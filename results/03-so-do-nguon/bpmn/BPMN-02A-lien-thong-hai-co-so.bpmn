<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_BPMN02A" targetNamespace="http://ehealth-ea/bpmn" exporter="tv1-gen" exporterVersion="1">
  <bpmn:collaboration id="Collab_BPMN02A">
    <bpmn:participant id="P_Clinic" name="Phòng khám ĐK An Tâm – cơ sở đang khám (CS2)" processRef="Proc_P_Clinic"/>
    <bpmn:participant id="P_CS1" name="Hệ thống cơ sở kia (CS1 – HIS-Lite, mock)"/>
    <bpmn:messageFlow id="Msg_1" name="Tra cứu chỉ số BN" sourceRef="a1" targetRef="P_CS1"/>
    <bpmn:messageFlow id="Msg_2" name="Truy vấn hồ sơ" sourceRef="a7" targetRef="P_CS1"/>
    <bpmn:messageFlow id="Msg_3" name="Dữ liệu CS1 (qua adapter)" sourceRef="P_CS1" targetRef="a7"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Clinic" name="Phòng khám ĐK An Tâm – cơ sở đang khám (CS2)" isExecutable="false">
    <bpmn:laneSet id="LS_P_Clinic">
      <bpmn:lane id="L_LT" name="Lễ tân (BR-LeTan)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_BS" name="Bác sĩ (BR-BacSi)">
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Hệ thống E-Health / Integration Hub">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="BE-02 BN đến CS2 (đã từng khám CS1)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="a0" name="BP-02.2 Xác minh danh tính &amp; BHYT"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a1" name="BP-06A.1 Tìm &amp; ghép định danh liên cơ sở (MPI)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Kết quả ghép?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="a2" name="BP-06A.2 Xác minh thủ công (CCCD, BHYT, hỏi BN)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Cùng một người?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a3" name="BP-06A.3 Liên kết định danh"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="a4" name="BP-06A.4 Tạo hồ sơ mới tại cơ sở"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="a5" name="BP-06A.5 Yêu cầu xem hồ sơ cơ sở kia"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Đã có đồng ý của BN?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="a6" name="BP-06A.6 Xin đồng ý của BN"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="BN đồng ý?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a7" name="BP-06A.7 Truy vấn &amp; chuyển đổi hồ sơ về mô hình chuẩn (FHIR)"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g5" name="Thiếu trường bắt buộc?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a8" name="BP-06A.8 Gắn cờ dữ liệu thiếu, cảnh báo"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gm" name=""><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="a9" name="BP-03.2 Xem hồ sơ &amp; tiền sử"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e" name="Tiếp tục khám (BP-03.3)"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
