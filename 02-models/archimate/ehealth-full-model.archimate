  <folder name="Strategy" id="id-49cb5bc0ac8a4f998e41fdf2d0f0a0ac" type="strategy">
    <element xsi:type="archimate:Capability" name="CAP-00 Khám chữa bệnh ngoại trú (năng lực tổng)" id="id-CAP-00"/>
    <element xsi:type="archimate:Capability" name="CAP-01 Quản lý lịch hẹn &amp; điều phối công suất" id="id-CAP-01">
      <documentation>Khoảng trống: MỚI (hiện chỉ có hotline + Google Sheet)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-02 Tiếp nhận &amp; định danh người bệnh" id="id-CAP-02">
      <documentation>Khoảng trống: NÂNG CẤP (nhập tay → QR/CCCD)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-03 Khám &amp; quản lý hồ sơ lâm sàng" id="id-CAP-03">
      <documentation>Khoảng trống: NÂNG CẤP (giấy → điện tử)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-04 Kê đơn an toàn" id="id-CAP-04">
      <documentation>Khoảng trống: MỚI (chưa có kiểm tra an toàn; CS2 chưa kê đơn điện tử)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-05 Liên thông đơn thuốc &amp; cấp thuốc" id="id-CAP-05">
      <documentation>Khoảng trống: MỚI</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-06 Kiểm soát truy cập &amp; lưu vết" id="id-CAP-06">
      <documentation>Khoảng trống: MỚI (tài khoản chung, không có log)</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-07 Quản trị dữ liệu người bệnh liên cơ sở" id="id-CAP-07">
      <documentation>Khoảng trống: MỚI — trọng tâm biến thể A</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-08 Đo lường &amp; cải tiến vận hành" id="id-CAP-08">
      <documentation>Khoảng trống: NÂNG CẤP</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-09 Thanh toán &amp; giám định BHYT" id="id-CAP-09">
      <documentation>Khoảng trống: GIỮ (Retain, ASSUMP-06)</documentation>
    </element>
    <element xsi:type="archimate:Resource" name="RS-01 Đội ngũ y tế (bác sĩ, điều dưỡng, dược sĩ)" id="id-RS-01"/>
    <element xsi:type="archimate:Resource" name="RS-02 Dữ liệu người bệnh &amp; đơn thuốc" id="id-RS-02"/>
