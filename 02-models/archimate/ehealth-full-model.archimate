    <element xsi:type="archimate:Resource" name="RS-04 Mạng lưới nhà thuốc liên kết (2 nội bộ + 6 đối tác)" id="id-RS-04"/>
    <element xsi:type="archimate:CourseOfAction" name="COA-01 Tuân thủ trước, tối ưu sau: bảo mật + kê đơn điện tử ở PLT-1" id="id-COA-01"/>
    <element xsi:type="archimate:CourseOfAction" name="COA-02 Số hóa đầu vào để giảm chờ: đặt lịch, check-in QR/CCCD" id="id-COA-02"/>
    <element xsi:type="archimate:CourseOfAction" name="COA-03 Liên thông qua cổng chuẩn, không buộc đối tác đổi phần mềm" id="id-COA-03"/>
    <element xsi:type="archimate:CourseOfAction" name="COA-04 Một hồ sơ người bệnh dùng chung cho 2 cơ sở" id="id-COA-04"/>
