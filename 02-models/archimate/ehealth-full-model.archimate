    <element xsi:type="archimate:Outcome" name="OC-04 ≥95% đơn liên thông ≤5 phút" id="id-OC-04"/>
    <element xsi:type="archimate:Outcome" name="OC-05 1 BN = 1 hồ sơ điện tử" id="id-OC-05"/>
