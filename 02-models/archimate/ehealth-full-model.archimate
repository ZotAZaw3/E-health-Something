    <element xsi:type="archimate:Driver" name="DRV-02 Sai sót đơn thuốc giấy" id="id-DRV-02"/>
    <element xsi:type="archimate:Driver" name="DRV-03 Quy định kê đơn điện tử &amp; liên thông" id="id-DRV-03"/>
    <element xsi:type="archimate:Driver" name="DRV-04 Bảo vệ dữ liệu cá nhân, lưu vết" id="id-DRV-04"/>
    <element xsi:type="archimate:Driver" name="DRV-05 Kết nối nhà thuốc đối tác" id="id-DRV-05"/>
    <element xsi:type="archimate:Driver" name="DRV-06 Hồ sơ phân tán 2 cơ sở" id="id-DRV-06"/>
    <element xsi:type="archimate:Assessment" name="ASM-01 Chờ TB 70 phút; 60% BN không hẹn" id="id-ASM-01"/>
    <element xsi:type="archimate:Assessment" name="ASM-02 ~3% đơn phải sửa; không cảnh báo tương tác" id="id-ASM-02"/>
    <element xsi:type="archimate:Assessment" name="ASM-03 CS2 chưa liên thông đơn; CS1 thủ công" id="id-ASM-03"/>
    <element xsi:type="archimate:Assessment" name="ASM-04 Tài khoản dùng chung, không log truy cập" id="id-ASM-04"/>
    <element xsi:type="archimate:Assessment" name="ASM-05 Nhà thuốc nhận đơn giấy/ảnh, không phản hồi" id="id-ASM-05"/>
    <element xsi:type="archimate:Assessment" name="ASM-06 BN có 2 mã ở 2 cơ sở" id="id-ASM-06"/>
    <element xsi:type="archimate:Goal" name="G-01 Giảm thời gian chờ khám" id="id-G-01"/>
    <element xsi:type="archimate:Goal" name="G-02 Nâng cao an toàn kê đơn" id="id-G-02"/>
    <element xsi:type="archimate:Goal" name="G-03 Bảo mật, tuân thủ, truy vết" id="id-G-03"/>
    <element xsi:type="archimate:Goal" name="G-04 Liên thông đơn thuốc" id="id-G-04"/>
    <element xsi:type="archimate:Goal" name="G-05 Hồ sơ bệnh nhân thống nhất" id="id-G-05"/>
    <element xsi:type="archimate:Outcome" name="OC-01 Chờ TB ≤ 45 phút; ≥60% có hẹn" id="id-OC-01"/>
    <element xsi:type="archimate:Outcome" name="OC-02 100% đơn điện tử; đơn phải sửa ≤0,5%" id="id-OC-02"/>
